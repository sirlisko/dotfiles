# Shared settings, included from ~/.gitconfig.
# Identity, signing and anything written by `git config --global` live there.
[alias]
	aa = add --all
	ap = add --patch
	br = branch
	ci = commit
	co = checkout
	di = diff
	dc = diff --cached
	ds = diff --stat
	hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
	pf = push --force-with-lease
	rlc = reset --hard HEAD~1
	st = status
	ulc = reset --soft HEAD~1
	restack = !git fetch origin && git rebase --update-refs --onto origin/main
[color]
	ui = auto
[core]
	ignorecase = false
	excludesfile = ~/.gitignore
	hooksPath = ~/dotfiles/git/hooks
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[fetch]
	prune = true
[push]
	default = simple
	autoSetupRemote = true
[pull]
	ff = only
[init]
	defaultBranch = main
[rerere]
	enabled = true
	autoUpdate = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[help]
	autocorrect = prompt
