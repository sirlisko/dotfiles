export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
DISABLE_MAGIC_FUNCTIONS=true

plugins=(copyfile git git-extras git-flow gh history macos zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

eval "$(starship init zsh)"

export PATH="$PATH:./node_modules/.bin"

export HISTSIZE=10000
export SAVEHIST=$HISTSIZE
setopt hist_ignore_all_dups
setopt hist_ignore_space

eval "$(thefuck --alias)"

eval "$(fzf --zsh)"
eval "$(zoxide init zsh)"
eval "$(direnv hook zsh)"

# mcfly is initialized after fzf so its ctrl-r binding wins over fzf's
eval "$(mcfly init zsh)"

for file in $HOME/dotfiles/zsh/{aliases,functions}; do
  [ -r "$file" ] && [ -f "$file" ] && source "$file";
done;
unset file;

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && . "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && . "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# Windsurf
export PATH="$HOME/.codeium/windsurf/bin:$PATH"

export PATH="$HOME/.local/bin:$PATH"

# Machine-specific settings and secrets, never committed
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
