export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""

plugins=(copyfile git git-extras github history zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

export PATH="$PATH:./node_modules/.bin"

export HISTSIZE=10000
export SAVEHIST=$HISTSIZE
setopt hist_ignore_all_dups
setopt hist_ignore_space

for file in $HOME/dotfiles/zsh/{aliases-server,functions}; do
  [ -r "$file" ] && [ -f "$file" ] && source "$file";
done;
unset file;

# Machine-specific settings and secrets, never committed
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
