#!/bin/bash
# Two-way sync between folders in git repos and the iCloud Obsidian vault,
# using Unison profiles in ~/.unison and a launchd job that runs every minute.

set -euo pipefail

UNISON_BIN="${UNISON_BIN:-/opt/homebrew/bin/unison}"
UNISON_DIR="$HOME/.unison"
VAULT="${OBSIDIAN_VAULT:-$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Vault}"
LABEL="local.obsidian-sync"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/obsidian-sync.log"
ERR_LOG="$HOME/Library/Logs/obsidian-sync.err.log"
LAST_RUN="$HOME/Library/Logs/obsidian-sync.last-run"
SELF="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/$(basename "$0")"

usage() {
  cat <<EOF
Usage: $(basename "$0") <command>

  add <name> <repo-dir> <vault-subfolder>  create a pair and run the first sync
  remove <name>                            stop syncing a pair (files are kept)
  list                                     show the pairs
  status                                   job state, conflicts and errors
  log                                      follow the sync log
  run                                      sync all pairs once (used by launchd)
  install                                  write common.prf, install and start the launchd job
  uninstall                                stop and remove the launchd job

Vault: $VAULT (override with OBSIDIAN_VAULT)
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

profiles() {
  find "$UNISON_DIR" -maxdepth 1 -name 'obsidian-*.prf' 2>/dev/null | sort
}

profile_name() {
  local base
  base="$(basename "$1" .prf)"
  echo "${base#obsidian-}"
}

roots() {
  sed -n 's/^root = //p' "$1"
}

cmd_add() {
  [ $# -eq 3 ] || die "usage: add <name> <repo-dir> <vault-subfolder>"
  local name="$1" repo vault_dir="$VAULT/$3"
  local profile="$UNISON_DIR/obsidian-$name.prf"

  [[ "$name" =~ ^[a-z0-9-]+$ ]] || die "name must be lowercase letters, digits and dashes"
  [ -e "$profile" ] && die "$profile already exists"
  [ -d "$2" ] || die "$2 is not a directory"
  [ -d "$VAULT" ] || die "vault not found: $VAULT"
  [ -f "$UNISON_DIR/common.prf" ] || die "missing $UNISON_DIR/common.prf (run: $(basename "$0") install)"
  repo="$(cd "$2" && pwd)"
  mkdir -p "$vault_dir"

  printf 'include common\nroot = %s\nroot = %s\n' "$repo" "$vault_dir" >"$profile"
  echo "Created $profile"
  "$UNISON_BIN" "obsidian-$name" && echo "First sync done"
}

cmd_remove() {
  [ $# -eq 1 ] || die "usage: remove <name>"
  local profile="$UNISON_DIR/obsidian-$1.prf"
  [ -f "$profile" ] || die "no pair called $1"
  rm "$profile"
  echo "Removed $profile. The files on both sides are untouched"
}

cmd_list() {
  local p
  while read -r p; do
    [ -n "$p" ] || continue
    echo "$(profile_name "$p")"
    roots "$p" | sed 's/^/  /'
  done < <(profiles)
}

last_sync() {
  [ -f "$LAST_RUN" ] && echo "  last run = $(stat -f '%Sm' -t '%F %T' "$LAST_RUN")"
  [ -s "$LOG" ] && echo "  last change = $(grep '^[0-9]' "$LOG" | tail -1)"
  return 0
}

cmd_status() {
  echo "== Job"
  local job
  if job="$(launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null)"; then
    echo "  loaded, syncs every minute"
    grep $'^\tlast exit code =' <<<"$job" | sed 's/^\t/  /' || true
    last_sync
  else
    echo "  not loaded (run: $(basename "$0") install)"
  fi

  echo "== Conflicts"
  local p found=0
  while read -r p; do
    [ -n "$p" ] || continue
    if find "$(roots "$p" | head -1)" -name '*(conflict_on_*' | sed 's/^/  /' | grep .; then
      found=1
    fi
  done < <(profiles)
  [ "$found" -eq 1 ] || echo "  none"

  echo "== Errors"
  if [ -s "$ERR_LOG" ]; then
    echo "  last written $(stat -f '%Sm' "$ERR_LOG")"
    tail -5 "$ERR_LOG" | sed 's/^/  /'
    if grep -q 'Operation not permitted' "$ERR_LOG"; then
      echo "  macOS is blocking access to iCloud Drive. Add this file to"
      echo "  Full Disk Access (it changes on every brew upgrade):"
      echo "  $(readlink -f "$UNISON_BIN")"
    fi
  else
    echo "  none"
  fi
}

cmd_log() {
  tail -f "$LOG"
}

cmd_run() {
  local p failed=0
  while read -r p; do
    [ -n "$p" ] || continue
    sync_pair "$(profile_name "$p")" || failed=1
  done < <(profiles)
  touch "$LAST_RUN"
  return "$failed"
}

# Logs only runs that changed something, as a dated header and one line per
# file. A failed run can still have transferred files, so both get logged
sync_pair() {
  local name="$1" out code=0
  out="$("$UNISON_BIN" "obsidian-$name" 2>&1 >/dev/null)" || code=$?
  if grep -q '^Synchronization complete' <<<"$out"; then
    {
      echo "$(date '+%F %T') $name: $(sed -n 's/^Synchronization complete at [0-9:]*  (\(.*\))$/\1/p' <<<"$out")"
      sed -n 's/^\[END\] /  /p' <<<"$out"
    } >>"$LOG"
  fi
  if [ "$code" -ne 0 ]; then
    echo "$(date '+%F %T') $name: unison exited with $code" >&2
    echo "$out" >&2
  fi
  return "$code"
}

write_common() {
  cat >"$UNISON_DIR/common.prf" <<EOF
ignore = Name .DS_Store
ignore = Name .*.icloud
ignore = Name .trash
batch = true
auto = true
times = true
perms = 0
prefer = newer
copyonconflict = true
confirmbigdel = true
EOF
}

cmd_install() {
  [ -x "$UNISON_BIN" ] || die "unison not found at $UNISON_BIN (brew install unison)"
  mkdir -p "$UNISON_DIR" "$(dirname "$PLIST")" "$(dirname "$LOG")"
  write_common
  cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$SELF</string><string>run</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardErrorPath</key><string>$ERR_LOG</string>
</dict>
</plist>
EOF
  plutil -lint -s "$PLIST"
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
  echo "Installed $PLIST, syncing every minute"
}

cmd_uninstall() {
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  rm -f "$PLIST"
  echo "Removed the launchd job. Profiles in $UNISON_DIR are kept"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  add | remove | list | status | log | run | install | uninstall) "cmd_$cmd" "$@" ;;
  *) usage ;;
esac
